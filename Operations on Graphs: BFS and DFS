#include <stdio.h>
#define MAX 20

int g[MAX][MAX],visited[MAX],n;

void dfs(int v) {
    printf("%d ",v);
    visited[v]=1;

    for(int i=0;i<n;i++)
        if(g[v][i]&&!visited[i])
            dfs(i);
}

void bfs(int start) {
    int q[MAX],front=0,rear=0;

    for(int i=0;i<n;i++) visited[i]=0;

    q[rear++]=start;
    visited[start]=1;

    while(front<rear) {
        int v=q[front++];
        printf("%d ",v);

        for(int i=0;i<n;i++)
            if(g[v][i]&&!visited[i]) {
                q[rear++]=i;
                visited[i]=1;
            }
    }
}

int main() {
    int e,u,v,start;

    printf("Enter vertices and edges: ");
    scanf("%d%d",&n,&e);

    printf("Enter edges (u v):\n");
    for(int i=0;i<e;i++) {
        scanf("%d%d",&u,&v);
        g[u][v]=g[v][u]=1;
    }

    printf("Enter starting vertex: ");
    scanf("%d",&start);

    for(int i=0;i<n;i++) visited[i]=0;
    printf("DFS: ");
    dfs(start);

    printf("\nBFS: ");
    bfs(start);

    return 0;
}
